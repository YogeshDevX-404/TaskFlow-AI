# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# FRONTEND API CONFIGURATION:
VITE_API_URL="http://localhost:5000/api/v1"

# BACKEND CONFIGURATION:
PORT=5000
MONGODB_URI="mongodb://127.0.0.1:27017/taskflow-ai"
CLIENT_URL="http://localhost:5173"
JWT_SECRET="development_jwt_secret_key"
JWT_REFRESH_SECRET="development_refresh_secret_key"
# GITHUB INTEGRATION CONFIGURATION:
GITHUB_MOCK_MODE="true"
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_CALLBACK_URL="http://localhost:5000/api/v1/integrations/github/callback"
GITHUB_API_URL="https://api.github.com"
GITHUB_WEBHOOK_SECRET="taskflow_github_webhook_secret_dev"
GITHUB_WEBHOOK_ENABLED="true"
INTEGRATION_ENCRYPTION_KEY=""

# EMAIL_PROVIDER choices: 'development' | 'smtp'
EMAIL_PROVIDER="development"
EMAIL_FROM="notifications@taskflow.ai"
EMAIL_FROM_NAME="TaskFlow AI"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""

